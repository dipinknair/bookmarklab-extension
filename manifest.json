{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "BookmarkLab",
  "default_locale": "en",
  "version": "1.1.1",
  "description": "__MSG_appDesc__",
  "author": "BookmarkLab",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BookmarkLab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {},
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "css/*",
        "js/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}